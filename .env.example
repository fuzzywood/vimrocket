# Copy to .env and fill in. Never commit the real .env.

# Public URL of the site (used in emails and to enable secure cookies + HSTS for https).
APP_URL=https://example.com

# Host port the container is published on (127.0.0.1 only; a reverse proxy forwards to it).
APP_PORT=3100

# SMTP server used for verification and password-reset emails.
# Leave SMTP_HOST empty to print emails to the log instead (useful for local testing).
SMTP_HOST=mail.example.com
SMTP_PORT=587
# true for implicit TLS (port 465), false for STARTTLS (port 587)
SMTP_SECURE=false
SMTP_USER=no-reply@example.com
SMTP_PASS=change-me

# Sender shown in emails. Must be an address the SMTP user is allowed to send as.
MAIL_FROM="LearnVim <no-reply@example.com>"

{
  "name": "learnvim",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "dev:web": "vite",
    "dev:api": "node --watch server/index.ts",
    "build": "npm run typecheck && vite build",
    "start": "NODE_ENV=production node server/index.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json",
    "test": "vitest run",
    "backup": "node server/backup.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "happy-dom": "^15.11.7",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  },
  "engines": {
    "node": ">=23.6"
  },
  "dependencies": {
    "nodemailer": "^10.6.0"
  }
}
